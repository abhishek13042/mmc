//@version=6
// =============================================================================
//  MMC STRUCTURE MAP  —  ITH / ITL (+ STH / STL)   faithful to the transcripts
//  Money Making Concepts (Arjo Janssens).  Definitions ported 1:1 from the
//  backtested Python core (mmc/core/swings.py + structure.py, transcripts 01-03):
//
//   SWING HIGH (transcript 01)  a candle whose high is greater than the L candles
//        to its left AND the R candles to its right. MMC default L=R=1 (the
//        3-candle swing). Confirmed only once the right candle closes.  SWING LOW
//        is the mirror.
//
//   INTERMEDIATE-TERM HIGH  ITH (transcript 02)  a SWING HIGH that has a *lower
//        swing high* immediately before AND after it (measured on the sequence of
//        swing highs, not on raw bars).  ITL = swing low with a *higher* swing low
//        either side.  << this "swing-of-swings" is the real definition — a bigger
//        pivot is NOT an ITH. >>
//
//   SHORT-TERM HIGH  STH (transcript 03)  a swing high *followed by a bearish FVG*
//        within a small window.  STL = swing low followed by a bullish FVG.
//
//  Works on EVERY timeframe you open, and can overlay ITH/ITL from up to two
//  higher timeframes so you see the full structure map at a glance.
//
//  Non-repainting: a swing confirms R bars late; an ITH/ITL confirms only once the
//  *next* lower/higher swing forms (this is faithful to the definition, so levels
//  print a little late but never move once printed).
//
//  Research tool — not financial advice.
// =============================================================================

indicator("MMC Structure Map — ITH/ITL", overlay = true,
     max_lines_count = 500, max_labels_count = 500, max_boxes_count = 50)

// ----------------------------------------------------------------------------
//  INPUTS
// ----------------------------------------------------------------------------
gStudy = "★ STUDY MODE"
studyMode = input.bool(false, "STUDY MODE — show everything", group = gStudy,
     tooltip = "One switch that turns on the FULL structure map at once: raw swings, " +
     "ITH/ITL (with labels, extend-until-swept and sweep marks), STH/STL, the dealing " +
     "range, BOTH higher timeframes and the dashboard — and keeps more history. Use it " +
     "to study how the structure built and how price ran the liquidity. While ON it " +
     "overrides the individual show-toggles below.")

gDef = "Swing definition (transcript 01)"
L = input.int(1, "Swing left bars (L)", minval = 1, maxval = 50, group = gDef,
     tooltip = "A swing high = high greater than L bars left and R bars right. " +
     "MMC default = 1 (3-candle swing). Increase for cleaner, higher-degree structure.")
R = input.int(1, "Swing right bars (R)", minval = 1, maxval = 50, group = gDef)

gSw = "Raw swings"
showSw = input.bool(false, "Show raw swing highs / lows", group = gSw)

gIT = "Intermediate-term structure (ITH / ITL)"
showIT   = input.bool(true, "Show ITH / ITL levels", group = gIT)
keepIT   = input.int(8, "Keep most-recent per side", minval = 1, maxval = 40, group = gIT)
extendIT = input.bool(true, "Extend each level until it is swept", group = gIT)
markSwept= input.bool(true, "Fade + mark a level once swept", group = gIT)
showItLab= input.bool(true, "Label ITH / ITL", group = gIT)

gST = "Short-term structure (STH / STL = swing + FVG, transcript 03)"
showST = input.bool(false, "Show STH / STL", group = gST)
fvgWin = input.int(3, "FVG must form within N bars of the swing", minval = 1, maxval = 10, group = gST)

gRng = "Dealing range (latest ITL -> latest ITH)"
showRange = input.bool(true, "Show dealing range (premium / EQ / discount)", group = gRng)

gHTF = "Higher-timeframe structure map"
htf1En = input.bool(true,  "Overlay HTF-1 ITH / ITL", group = gHTF)
htf1   = input.timeframe("60",  "HTF 1", group = gHTF)
htf2En = input.bool(false, "Overlay HTF-2 ITH / ITL", group = gHTF)
htf2   = input.timeframe("240", "HTF 2", group = gHTF)

gViz = "Visuals"
cHi = input.color(#1d9e75, "ITH / sell-side liquidity (premium)", group = gViz)
cLo = input.color(#e64a3b, "ITL / buy-side liquidity (discount)", group = gViz)
cEq = input.color(color.new(#808080, 0), "Equilibrium", group = gViz)
showDash = input.bool(true, "Show structure dashboard", group = gViz)

// ---- effective toggles: STUDY MODE forces the whole map on --------------------
eShowSw    = studyMode or showSw
eShowIT    = studyMode or showIT
eExtend    = studyMode or extendIT
eMarkSw    = studyMode or markSwept
eShowLab   = studyMode or showItLab
eShowST    = studyMode or showST
eShowRange = studyMode or showRange
eHtf1      = studyMode or htf1En
eHtf2      = studyMode or htf2En
eShowDash  = studyMode or showDash
eKeep      = studyMode ? math.max(keepIT, 20) : keepIT

// ----------------------------------------------------------------------------
//  CORE STRUCTURE FUNCTION  (reused for the chart TF and each higher TF)
//  Returns the newest ITH/ITL event + the last-known ITH/ITL price.
//  ITH logic: keep the last two confirmed swing highs (A,B); when the next swing
//  high C confirms, B is an ITH iff  B > A  and  B > C  (lower highs either side).
// ----------------------------------------------------------------------------
f_struct(int _L, int _R) =>
    ph = ta.pivothigh(high, _L, _R)
    pl = ta.pivotlow(low,  _L, _R)

    var float shA = na            // swing-high two back
    var float shB = na            // swing-high one back (candidate middle)
    var int   shBbar = na
    var float slA = na
    var float slB = na
    var int   slBbar = na
    var float lastITH = na
    var float lastITL = na

    bool  newITH = false
    float ithP   = na
    int   ithBar = na
    bool  newITL = false
    float itlP   = na
    int   itlBar = na

    if not na(ph)
        int pbar = bar_index - _R
        if not na(shA) and not na(shB)
            if shB > shA and shB > ph          // lower swing high either side -> ITH
                newITH := true
                ithP   := shB
                ithBar := shBbar
                lastITH := shB
        shA := shB
        shB := ph
        shBbar := pbar

    if not na(pl)
        int pbar = bar_index - _R
        if not na(slA) and not na(slB)
            if slB < slA and slB < pl          // higher swing low either side -> ITL
                newITL := true
                itlP   := slB
                itlBar := slBbar
                lastITL := slB
        slA := slB
        slB := pl
        slBbar := pbar

    [newITH, ithP, ithBar, lastITH, newITL, itlP, itlBar, lastITL]

// ----------------------------------------------------------------------------
//  CHART-TIMEFRAME STRUCTURE
// ----------------------------------------------------------------------------
[cNewITH, cIthP, cIthBar, cLastITH, cNewITL, cItlP, cItlBar, cLastITL] = f_struct(L, R)

// ---- raw swing markers -----------------------------------------------------
phv = ta.pivothigh(high, L, R)
plv = ta.pivotlow(low,  L, R)
plotchar(eShowSw and not na(phv) ? high[R] : na, "swing high", "▽",
     location.abovebar, color.new(cHi, 30), offset = -R, size = size.tiny)
plotchar(eShowSw and not na(plv) ? low[R]  : na, "swing low",  "△",
     location.belowbar, color.new(cLo, 30), offset = -R, size = size.tiny)

// ---- ITH / ITL levels: draw at the historical swing, extend until swept -----
var array<line>  hiLn = array.new_line()
var array<label> hiLb = array.new_label()
var array<float> hiLv = array.new_float()
var array<bool>  hiSw = array.new_bool()
var array<line>  loLn = array.new_line()
var array<label> loLb = array.new_label()
var array<float> loLv = array.new_float()
var array<bool>  loSw = array.new_bool()

if eShowIT and cNewITH and not na(cIthP)
    line ln = line.new(cIthBar, cIthP, bar_index, cIthP, color = color.new(cHi, 0), width = 1)
    label lb = eShowLab ? label.new(cIthBar, cIthP, "ITH", style = label.style_label_down,
         color = color.new(cHi, 85), textcolor = cHi, size = size.tiny) : na
    array.push(hiLn, ln)
    array.push(hiLb, lb)
    array.push(hiLv, cIthP)
    array.push(hiSw, false)
    if array.size(hiLn) > eKeep
        line.delete(array.shift(hiLn))
        label.delete(array.shift(hiLb))
        array.shift(hiLv)
        array.shift(hiSw)

if eShowIT and cNewITL and not na(cItlP)
    line ln = line.new(cItlBar, cItlP, bar_index, cItlP, color = color.new(cLo, 0), width = 1)
    label lb = eShowLab ? label.new(cItlBar, cItlP, "ITL", style = label.style_label_up,
         color = color.new(cLo, 85), textcolor = cLo, size = size.tiny) : na
    array.push(loLn, ln)
    array.push(loLb, lb)
    array.push(loLv, cItlP)
    array.push(loSw, false)
    if array.size(loLn) > eKeep
        line.delete(array.shift(loLn))
        label.delete(array.shift(loLb))
        array.shift(loLv)
        array.shift(loSw)

// extend / sweep-check every bar.
// NOTE: Pine `for i = 0 to n-1` iterates DOWNWARD when n = 0 (0 -> -1), so the
// size guards below are required to avoid array.get() out-of-bounds on bar 0.
if eShowIT
    int hn = array.size(hiLn)
    if hn > 0
        for i = 0 to hn - 1
            if not array.get(hiSw, i)
                float lvl = array.get(hiLv, i)
                line   ln = array.get(hiLn, i)
                if high > lvl                               // buy-side liquidity taken
                    array.set(hiSw, i, true)
                    line.set_x2(ln, bar_index)
                    if eMarkSw
                        line.set_style(ln, line.style_dashed)
                        line.set_color(ln, color.new(cHi, 55))
                else if eExtend
                    line.set_x2(ln, bar_index)
    int ln_lo = array.size(loLn)
    if ln_lo > 0
        for i = 0 to ln_lo - 1
            if not array.get(loSw, i)
                float lvl = array.get(loLv, i)
                line   ln = array.get(loLn, i)
                if low < lvl                                // sell-side liquidity taken
                    array.set(loSw, i, true)
                    line.set_x2(ln, bar_index)
                    if eMarkSw
                        line.set_style(ln, line.style_dashed)
                        line.set_color(ln, color.new(cLo, 55))
                else if eExtend
                    line.set_x2(ln, bar_index)

// ----------------------------------------------------------------------------
//  SHORT-TERM STRUCTURE  (swing + FVG within window) — transcript 03
// ----------------------------------------------------------------------------
var int   lastPHbar = na
var float lastPHp   = na
var int   lastPLbar = na
var float lastPLp   = na
if not na(phv)
    lastPHbar := bar_index - R
    lastPHp   := high[R]
if not na(plv)
    lastPLbar := bar_index - R
    lastPLp   := low[R]

bearFVG = high < low[2]      // 3-candle bearish FVG completing on this bar
bullFVG = low  > high[2]     // 3-candle bullish FVG
if eShowST and bearFVG and not na(lastPHbar) and (bar_index - lastPHbar) <= fvgWin + R
    label.new(lastPHbar, lastPHp, "STH", style = label.style_label_down,
         color = color.new(cHi, 70), textcolor = cHi, size = size.tiny)
if eShowST and bullFVG and not na(lastPLbar) and (bar_index - lastPLbar) <= fvgWin + R
    label.new(lastPLbar, lastPLp, "STL", style = label.style_label_up,
         color = color.new(cLo, 70), textcolor = cLo, size = size.tiny)

// ----------------------------------------------------------------------------
//  HIGHER-TIMEFRAME ITH / ITL  +  DEALING-RANGE lines  (shared drawing helper)
// ----------------------------------------------------------------------------
// Each timeframe draws in its own horizontal "lane": the right end of the line
// and its label sit at a different bar offset (labOff), so levels from different
// timeframes never stack on top of each other even when they share a price.
f_level(bool en, float lvl, color col, string txt, string sty, int wdt, int back, int labOff) =>
    var line  ln = na
    var label lb = na
    if en and not na(lvl)
        if na(ln)
            ln := line.new(bar_index, lvl, bar_index, lvl, color = col, style = sty, width = wdt)
            lb := label.new(bar_index, lvl, txt, style = label.style_label_left,
                 textcolor = col, color = color.new(color.black, 100), size = size.small)
        line.set_y1(ln, lvl)
        line.set_y2(ln, lvl)
        line.set_x1(ln, bar_index - back)
        line.set_x2(ln, bar_index + labOff)
        line.set_color(ln, col)
        line.set_width(ln, wdt)
        label.set_xy(lb, bar_index + labOff, lvl)
        label.set_text(lb, txt)
        label.set_textcolor(lb, col)

// dealing range on the chart TF: latest ITL -> latest ITH, with equilibrium.
// LANE 0 (nearest price, offset +2): the chart-timeframe dealing range.
rngEq = not na(cLastITH) and not na(cLastITL) ? (cLastITH + cLastITL) / 2 : na
f_level(eShowRange, cLastITH, color.new(cHi, 20), timeframe.period + " Premium (ITH)", line.style_dotted, 1, 120, 2)
f_level(eShowRange, rngEq,    cEq,                timeframe.period + " EQ 50%",         line.style_dotted, 1, 120, 2)
f_level(eShowRange, cLastITL, color.new(cLo, 20), timeframe.period + " Discount (ITL)", line.style_dotted, 1, 120, 2)

// higher-timeframe structure via request.security (lookahead OFF -> no repaint).
// LANE 1 (offset +11): HTF-1, dashed.   LANE 2 (offset +21): HTF-2, dashed + thicker.
[d1a, d1b, d1c, h1ITH, d1e, d1f, d1g, h1ITL] = request.security(syminfo.tickerid, htf1, f_struct(L, R), lookahead = barmerge.lookahead_off)
[d2a, d2b, d2c, h2ITH, d2e, d2f, d2g, h2ITL] = request.security(syminfo.tickerid, htf2, f_struct(L, R), lookahead = barmerge.lookahead_off)
f_level(eHtf1, h1ITH, cHi, htf1 + " ITH", line.style_dashed, 1, 100, 11)
f_level(eHtf1, h1ITL, cLo, htf1 + " ITL", line.style_dashed, 1, 100, 11)
f_level(eHtf2, h2ITH, cHi, htf2 + " ITH", line.style_dashed, 2, 100, 21)
f_level(eHtf2, h2ITL, cLo, htf2 + " ITL", line.style_dashed, 2, 100, 21)

// ----------------------------------------------------------------------------
//  DASHBOARD
// ----------------------------------------------------------------------------
f_px(float v) => na(v) ? "—" : str.tostring(v, format.mintick)

var table dash = table.new(position.top_right, 3, 4, border_width = 1)
if eShowDash and barstate.islast
    table.clear(dash, 0, 0, 2, 3)
    table.cell(dash, 0, 0, "TF",  text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 0, "ITH", text_color = cHi, text_size = size.small)
    table.cell(dash, 2, 0, "ITL", text_color = cLo, text_size = size.small)
    table.cell(dash, 0, 1, timeframe.period, text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 1, f_px(cLastITH), text_color = cHi, text_size = size.small)
    table.cell(dash, 2, 1, f_px(cLastITL), text_color = cLo, text_size = size.small)
    table.cell(dash, 0, 2, eHtf1 ? htf1: "—", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 2, eHtf1 ? f_px(h1ITH) : "—", text_color = cHi, text_size = size.small)
    table.cell(dash, 2, 2, eHtf1 ? f_px(h1ITL) : "—", text_color = cLo, text_size = size.small)
    table.cell(dash, 0, 3, eHtf2 ? htf2: "—", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 3, eHtf2 ? f_px(h2ITH) : "—", text_color = cHi, text_size = size.small)
    table.cell(dash, 2, 3, eHtf2 ? f_px(h2ITL) : "—", text_color = cLo, text_size = size.small)

// ----------------------------------------------------------------------------
//  ALERTS
// ----------------------------------------------------------------------------
alertcondition(cNewITH, "New ITH", "MMC: a new Intermediate-Term High printed")
alertcondition(cNewITL, "New ITL", "MMC: a new Intermediate-Term Low printed")
